# Local development defaults. Never place real credentials in this file.
APP_ENV=development
DATABASE_URL=sqlite:///./nexorion.db
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
ALLOW_SELF_REGISTRATION=true

# For PostgreSQL, use a private/local connection URL and keep credentials outside source control:
# DATABASE_URL=postgresql+psycopg://nexorion_user:replace-me@localhost:5432/nexorion

# Comma-separated exact origin(s) for a separately hosted frontend. Leave empty when
# the browser uses the same origin/Vite proxy. Never set this to "*".
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
